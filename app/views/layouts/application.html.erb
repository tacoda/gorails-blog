<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Common Features" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Tailwind CSS import %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100">
    <!-- Navigation -->
    <nav class="bg-white shadow-sm border-b w-full">
      <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 w-full">
          <div class="flex items-center space-x-8">
            <%= link_to root_path, class: "text-xl font-semibold text-gray-900 hover:text-gray-700" do %>
              Common Features
            <% end %>
            <%= link_to "Blog Posts",
            blog_posts_path,
            class:
              "text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium" %>
            <% if user_signed_in? %>
              <%= link_to "New Post",
              new_blog_post_path,
              class:
                "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            <% end %>
          </div>
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <%= link_to "Profile",
              edit_user_registration_path,
              class:
                "text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium" %>
              <%= button_to "Logout",
              destroy_user_session_path,
              method: :delete,
              class:
                "text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium bg-transparent border-none cursor-pointer",
              data: {
                confirm: "Are you sure?",
              } %>
            <% else %>
              <%= link_to "Login",
              new_user_session_path,
              class:
                "text-gray-700 hover:text-gray-900 px-3 py-2 rounded-md text-sm font-medium" %>
              <%= link_to "Sign Up",
              new_user_registration_path,
              class:
                "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    <!-- Flash Messages -->
    <% if notice %>
      <div
        class="
          bg-green-50 border border-green-200 text-green-800 px-4 py-3 rounded-md mx-4
          mt-4
        "
      >
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div
        class="
          bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-md mx-4 mt-4
        "
      >
        <%= alert %>
      </div>
    <% end %>
    <!-- Main Content -->
    <main class="max-w-7xl mx-auto py-6 px-4 sm:px-6 lg:px-8">
      <%= yield %>
    </main>
  </body>
</html>
