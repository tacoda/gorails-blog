<h1 class="text-3xl">My Blog</h1>

<% @blog_posts.each do |blog_post| %>
  <div class="mt-6">
    <%= image_tag blog_post.cover_image if blog_post.cover_image.present? %>
    <h2><%= link_to blog_post.title, blog_post, class: "text-xl font-bold text-blue-500" %></h2>
    <% if blog_post.draft? %>
      <div class="p-2 rounded bg-gray-100 text-gray-900">Draft</div>
    <% elsif blog_post.scheduled? %>
      <div class="p-2 rounded bg-gray-100 text-gray-900">Scheduled</div>
    <% end %>
  </div>
<% end %>

<% if @pagy.count > @pagy.limit %>
  <div class="my-16">
    <%== pagy_nav(@pagy) %>
  </div>
<% end %>

